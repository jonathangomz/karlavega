---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { langCodes, localizePath, stripLang, useTranslations, withBase, type Lang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title?: string;
  subtitle?: string;
  description?: string;
}

const { lang, title, subtitle, description } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title ? `${title} — ${site.name}` : subtitle ? `${site.name} — ${subtitle}` : site.name;
const basePath = stripLang(Astro.url.pathname);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description ?? t('site.tagline')} />
    <link rel="icon" href={withBase('/logo.png')} type="image/png" />
    {
      langCodes.map((code) => (
        <link rel="alternate" hreflang={code} href={new URL(localizePath(basePath, code), Astro.site)} />
      ))
    }
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header lang={lang} />
    <main class="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
