---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import { getWorks, workImage, workCaption, localizeWork } from '../../lib/works';
import { langParams, localizePath, toLang, useTranslations } from '../../i18n/ui';

export const getStaticPaths = (() =>
  langParams().map((params) => ({ params }))) satisfies GetStaticPaths;

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);

const works = await getWorks();
const [featured, ...rest] = works;
const recent = rest.slice(0, 3);
const featuredText = featured ? localizeWork(featured, lang) : null;
---

<BaseLayout lang={lang}>
  <div class="container">
    {
      featured && featuredText && (
        <section class="featured">
          <a class="featured__link" href={localizePath(`/works/${featured.id}`, lang)}>
            <div class="featured__frame">
              <img
                class="featured__image"
                src={workImage(featured, lang)}
                alt={featuredText.title}
                width={featured.data.imageWidth}
                height={featured.data.imageHeight}
                fetchpriority="high"
              />
            </div>
            <div class="featured__caption">
              <h1 class="featured__title">{featuredText.title}</h1>
              <p class="featured__meta">{workCaption(featured, lang)}</p>
            </div>
          </a>
        </section>
      )
    }

    {
      recent.length > 0 && (
        <section class="recent">
          <h2 class="eyebrow recent__heading">{t('home.recent')}</h2>
          <WorkGrid works={recent} lang={lang} eagerCount={0} />
          <p class="recent__more">
            <a class="link-underline" href={localizePath('/works', lang)}>
              {t('home.viewAll')}
            </a>
          </p>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .featured {
    margin-bottom: var(--space-xl);
  }

  .featured__frame {
    max-height: 78vh;
    display: flex;
    justify-content: flex-start;
  }

  .featured__image {
    width: auto;
    max-width: 100%;
    max-height: 78vh;
    object-fit: contain;
  }

  .featured__link:hover .featured__image {
    opacity: 0.9;
  }

  .featured__caption {
    margin-top: var(--space-sm);
  }

  .featured__title {
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.3;
  }

  .featured__meta {
    font-size: var(--step-1);
    font-weight: 300;
    color: var(--color-muted);
  }

  .recent__heading {
    margin-bottom: var(--space-md);
  }

  .recent__more {
    margin-top: var(--space-md);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
</style>
