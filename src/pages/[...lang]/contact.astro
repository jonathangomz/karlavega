---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { langParams, toLang, useTranslations } from '../../i18n/ui';

export const getStaticPaths = (() =>
  langParams().map((params) => ({ params }))) satisfies GetStaticPaths;

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('contact.title')}>
  <div class="container contact">
    <h1 class="page-title contact__title">{t('contact.title')}</h1>

    <div class="prose">
      <p class="muted">{t('contact.intro')}</p>
      <p class="contact__email">
        <a class="link-underline" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>

    <ul class="contact__social">
      {
        site.social.map((item) => (
          <li>
            <a class="link-underline" href={item.href} target="_blank" rel="noopener noreferrer">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .contact__title {
    margin-bottom: var(--space-md);
  }

  .contact__email {
    margin-top: var(--space-md);
    font-size: var(--step-1);
  }

  .contact__social {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
</style>
